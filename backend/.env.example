# @file backend/.env.example
# @description 后端环境变量示例（数据库、JWT、内存库开关、AI 配置）

# 服务器端口
PORT=3000

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET=change-me-to-a-random-secret

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campushub

# 数据库连接池
DB_POOL_MIN=2
DB_POOL_MAX=10

# 开发默认使用内存库；生产可设为 0 并配置 MySQL
USE_MEMORY_DB=1

# ===== AI 配置 =====
# AI 提供商（openai / deepseek / zhipu）
AI_PROVIDER=openai
# AI 模型
AI_MODEL=gpt-4.1-mini
# ⚠️ API Key 不在此处配置！
# 请使用以下方式之一设置 API Key：
# 1. [推荐] 运行 node scripts/setup-credentials.js 加密存储
# 2. [不推荐] 设置环境变量 OPENAI_API_KEY / DEEPSEEK_API_KEY / ZHIPU_API_KEY
#    环境变量方式为明文存储，存在安全风险，详见 SPEC.md 安全章节
